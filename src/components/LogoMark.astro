---
interface Props { class?: string; mono?: boolean }
const { class: cls = 'h-10 w-10', mono = false } = Astro.props;
const leaf = mono ? 'currentColor' : '#12A02C';
const leafLight = mono ? 'currentColor' : '#3CC157';
---
<svg viewBox="0 0 64 64" class={cls} aria-hidden="true" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- feuille gauche -->
  <path d="M30.5 30C19 30.5 9 23.5 7 7.5c14.5-.5 24.5 8 23.5 22.5Z" fill={leaf} />
  <!-- feuille droite -->
  <path d="M33.5 25.5C35 12.5 45 5 58 5.5 57.5 19 47.5 27.5 33.5 25.5Z" fill={leafLight} />
  <!-- nervures -->
  <path d="M29 28C23 22.5 17 16.5 12 11" stroke="white" stroke-width="1.6" stroke-linecap="round" opacity=".9" />
  <path d="M35 23.5C41 18 47 13 53 9.5" stroke="white" stroke-width="1.6" stroke-linecap="round" opacity=".9" />
  <!-- tige -->
  <path d="M31 29.5c1 2.5 1 6 1 10.5M33.6 25.6c-1.4 3-1.6 7-1.6 14.4" stroke={leaf} stroke-width="3" stroke-linecap="round" />
  <!-- fiche -->
  <rect x="24.5" y="39.5" width="15" height="10" rx="3.2" fill={leaf} />
  <rect x="28.5" y="48" width="7" height="4" rx="1" fill={leaf} />
  <rect x="27" y="51.5" width="3" height="8" rx="1.3" fill={leaf} />
  <rect x="34" y="51.5" width="3" height="8" rx="1.3" fill={leaf} />
</svg>
