---
import Waves from './Waves.astro';
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="grain relative isolate overflow-hidden bg-forest-950 pb-36 pt-36 text-white sm:pb-44 sm:pt-44">
  <div class="grid-lines absolute inset-0 -z-10"></div>
  <div class="absolute -left-32 top-10 -z-10 h-96 w-96 rounded-full bg-leaf-500/25 blur-[130px]" data-parallax="0.12"></div>
  <div class="absolute right-0 top-0 -z-10 h-80 w-80 rounded-full bg-sun-400/10 blur-[120px]"></div>
  <div class="container-x">
    <span class="eyebrow border-white/15 bg-white/5 text-leaf-300" data-reveal>{eyebrow}</span>
    <h1 class="mt-6 max-w-4xl font-display text-[2.6rem] font-semibold leading-[1.05] sm:text-6xl" data-split data-split-delay="100">{title}</h1>
    {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70" data-reveal style="--delay:350ms">{lead}</p>}
    <slot />
  </div>
  <Waves />
</section>
