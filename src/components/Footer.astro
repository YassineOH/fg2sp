---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site, solutions } from '../data/site';
const year = new Date().getFullYear();
---

<footer class='relative overflow-hidden bg-forest-950 text-white/70'>
  <div class='pointer-events-none absolute -top-40 left-1/2 h-80 w-[60rem] -translate-x-1/2 rounded-full bg-leaf-500/20 blur-[120px]'></div>

  <div class='container-x relative'>
    <!-- Bandeau CTA -->
    <div class='flex flex-col items-start justify-between gap-8 border-b border-white/10 py-16 md:flex-row md:items-end'>
      <div>
        <p class='font-display text-sm font-semibold uppercase tracking-[0.2em] text-leaf-400'>
          Prêt à passer au solaire ?
        </p>
        <h2 class='mt-3 max-w-2xl font-display text-4xl font-semibold text-white sm:text-5xl'>
          Parlons de votre projet,{' '}
          <span class='text-gradient'>l'étude est offerte.</span>
        </h2>
      </div>
      <div class='flex flex-wrap gap-3'>
        <a href='/simulateur/' class='btn btn-ghost-dark'>
          <Icon name='calc' class='h-5 w-5' />
          Simuler
        </a>
        <a href='/contact/' class='btn btn-primary'>
          Demander un devis
          <Icon name='arrow' class='h-4 w-4' />
        </a>
      </div>
    </div>

    <div class='grid gap-12 py-14 sm:grid-cols-2 lg:grid-cols-12'>
      <div class='lg:col-span-4'>
        <a href='/' class='group inline-block'>
          <Logo dark />
        </a>
        <p class='mt-5 max-w-sm text-sm leading-relaxed'>
          <strong class='font-semibold text-white'>{site.fullName}.</strong> Une
          entreprise marocaine dédiée à l'énergie solaire, de l'étude à la
          maintenance.
        </p>
      </div>
      <div class='lg:col-span-2'>
        <p class='font-display text-sm font-semibold text-white'>Navigation</p>
        <ul class='mt-4 space-y-2.5 text-sm'>
          {nav.map((n) => (
            <li>
              <a class='transition hover:text-leaf-400' href={n.href}>
                {n.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class='lg:col-span-3'>
        <p class='font-display text-sm font-semibold text-white'>Solutions</p>
        <ul class='mt-4 space-y-2.5 text-sm'>
          {solutions.map((s) => (
            <li>
              <a
                class='transition hover:text-leaf-400'
                href={`/solutions/#${s.slug}`}
              >
                {s.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class='lg:col-span-3'>
        <p class='font-display text-sm font-semibold text-white'>Contact</p>
        <ul class='mt-4 space-y-3 text-sm'>
          <li>
            <a
              class='inline-flex items-center gap-2.5 transition hover:text-leaf-400'
              href={site.phoneHref}
            >
              <Icon name='phone' class='h-4 w-4 text-leaf-400' />
              {site.phone}
            </a>
          </li>
          <li>
            <a
              class='inline-flex items-center gap-2.5 transition hover:text-leaf-400'
              href={`mailto:${site.email}`}
            >
              <Icon name='mail' class='h-4 w-4 text-leaf-400' />
              {site.email}
            </a>
          </li>
          <li class='inline-flex items-center gap-2.5'>
            <Icon name='clock' class='h-4 w-4 text-leaf-400' />
            {site.hours}
          </li>
        </ul>
      </div>
    </div>

    <div class='flex flex-col gap-3 border-t border-white/10 py-7 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between'>
      <p>© {year} FG2SP Energie. Tous droits réservés.</p>
      <p>Fait au Maroc, alimenté par le soleil ☀︎</p>
    </div>
  </div>
</footer>
