---
import LogoMark from './LogoMark.astro';
interface Props { dark?: boolean; class?: string }
const { dark = false, class: cls = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', cls]}>
  <LogoMark class="h-10 w-10 shrink-0 transition-transform duration-500 group-hover:-rotate-6 group-hover:scale-110" />
  <span class="flex flex-col leading-none">
    <span class:list={['font-display text-[22px] font-extrabold tracking-tight', dark ? 'text-white' : 'text-ink']}>FG2SP</span>
    <span class:list={['font-display text-[10.5px] font-semibold tracking-[0.42em]', dark ? 'text-leaf-300' : 'text-leaf-600']}>ENERGIE</span>
  </span>
</span>
