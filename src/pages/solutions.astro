---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { solutions } from '../data/site';

const modes = [
  { title: 'Raccordé au réseau (on-grid)', text: "Vous consommez en priorité votre production solaire et le réseau prend le relais la nuit. La solution la plus rentable pour réduire votre facture.", tag: 'Le plus rentable' },
  { title: 'Autonome (off-grid)', text: "Panneaux et batteries pour les sites non raccordés : fermes, gîtes, relais, habitations isolées.", tag: 'Sites isolés' },
  { title: 'Hybride', text: "Le meilleur des deux mondes : réseau ou groupe électrogène + solaire + stockage, pour une alimentation continue même en cas de coupure.", tag: 'Continuité de service' },
];
---
<Base title="Nos solutions solaires" description="Centrales solaires, pompage solaire, éclairage solaire, systèmes autonomes, études et maintenance : découvrez les solutions photovoltaïques de FG2SP Energie au Maroc." overlayHeader>
  <PageHero eyebrow="Nos solutions" title="Du lampadaire autonome à la centrale solaire." lead="Six expertises complémentaires pour couvrir tous vos besoins en énergie solaire, avec une seule équipe du début à la fin.">
    <div class="mt-10 flex flex-wrap gap-2" data-reveal style="--delay:500ms">
      {solutions.map((s) => (
        <a href={`#${s.slug}`} class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/80 transition hover:border-leaf-400 hover:bg-leaf-500 hover:text-white">
          <Icon name={s.icon} class="h-4 w-4" />{s.title}
        </a>
      ))}
    </div>
  </PageHero>

  <section class="py-20 sm:py-28">
    <div class="container-x space-y-6">
      {solutions.map((s, i) => (
        <article id={s.slug} class="card spotlight grid scroll-mt-28 gap-10 p-7 sm:p-12 lg:grid-cols-2" data-reveal>
          <div class:list={[i % 2 === 1 && 'lg:order-2']}>
            <div class="flex items-center gap-4">
              <span class="grid h-16 w-16 place-items-center rounded-2xl bg-leaf-500 text-white shadow-[0_14px_30px_-12px_rgba(18,160,44,0.8)]"><Icon name={s.icon} class="h-8 w-8" /></span>
              <span class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-ink/40">{s.for}</span>
            </div>
            <h2 class="mt-7 font-display text-3xl font-semibold text-forest-900 sm:text-4xl">{s.title}</h2>
            <p class="mt-4 text-lg leading-relaxed text-ink/70">{s.long}</p>
            <a href={`/contact/?solution=${s.slug}`} class="btn btn-primary mt-8">Demander une étude<Icon name="arrow" class="h-4 w-4" /></a>
          </div>
          <div class:list={['relative overflow-hidden rounded-3xl bg-forest-900 p-7 text-white sm:p-9', i % 2 === 1 && 'lg:order-1']}>
            <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-leaf-500/30 blur-3xl"></div>
            <Icon name={s.icon} class="absolute -bottom-6 -right-6 h-44 w-44 text-white/[0.05]" />
            <p class="relative font-display text-sm font-semibold uppercase tracking-[0.18em] text-leaf-300">Ce que nous faisons</p>
            <ul class="relative mt-6 space-y-4">
              {s.points.map((p) => (
                <li class="flex gap-3">
                  <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-leaf-500/25 text-leaf-300"><Icon name="check" class="h-3.5 w-3.5" /></span>
                  <span class="text-white/85">{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-sand-100/70 py-24 sm:py-28">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow border-leaf-500/25 bg-white text-leaf-700" data-reveal>Architectures</span>
        <h2 class="mt-5 font-display text-4xl font-semibold leading-tight text-forest-900 sm:text-5xl" data-split>On-grid, off-grid ou hybride ?</h2>
        <p class="mt-5 text-lg text-ink/65" data-reveal>Nous choisissons avec vous l'architecture la plus adaptée à votre site et à vos usages.</p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {modes.map((m, i) => (
          <div class="card spotlight p-8" data-reveal style={`--delay:${i * 100}ms`}>
            <span class="rounded-full bg-leaf-50 px-3 py-1 text-xs font-semibold text-leaf-700">{m.tag}</span>
            <h3 class="mt-5 font-display text-2xl font-semibold text-forest-900">{m.title}</h3>
            <p class="mt-3 leading-relaxed text-ink/65">{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
