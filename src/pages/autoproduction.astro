---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';

const timeline = [
  { date: 'Février 2023', title: 'Promulgation de la loi 82-21', text: "La loi relative à l'autoproduction d'énergie électrique est promulguée par le dahir n° 1-23-21 du 10 février 2023." },
  { date: 'Février 2026', title: "Tarifs de l'excédent fixés par l'ANRE", text: "L'Autorité nationale de régulation de l'électricité fixe les tarifs d'achat de l'excédent pour la haute et la moyenne tension, valables du 1er mars 2026 au 28 février 2027. La basse tension sera traitée ultérieurement." },
  { date: 'Mars 2026', title: "Publication du décret d'application", text: "Le décret qui rend la loi opérationnelle est publié au Bulletin officiel, après plus de trois ans d'attente." },
  { date: 'Juin 2026', title: 'Entrée en vigueur', text: "Le décret entre en vigueur trois mois après sa publication, à partir du 9 juin 2026." },
];
const facts = [
  { value: '20 %', label: "de la production annuelle peut être injectée sur le réseau au maximum" },
  { value: '0,21', unit: 'MAD/kWh', label: "tarif d'achat de l'excédent en heures de pointe (MT/HT)" },
  { value: '0,18', unit: 'MAD/kWh', label: "tarif d'achat de l'excédent hors heures de pointe (MT/HT)" },
  { value: '3 886', unit: 'MW', label: "de capacité d'accueil réseau ouverte à l'autoproduction (72 % solaire, 28 % éolien)" },
];
---
<Base title="Loi 82-21 : l'autoproduction au Maroc" description="Loi 82-21 sur l'autoproduction d'électricité au Maroc : décret d'application 2026, revente de l'excédent (20 %), tarifs ANRE. Le guide FG2SP Energie.">
  <PageHero eyebrow="Guide · Loi 82-21" title="Autoproduction : ce que la loi 82-21 change pour vous." lead="Produire sa propre électricité solaire, la consommer et revendre une partie de l'excédent : le cadre est enfin opérationnel. Voici l'essentiel, mis à jour en novembre 2026." />

  <section class="py-20 sm:py-28">
    <div class="container-x grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {facts.map((f, i) => (
        <div class="card spotlight p-7" data-reveal style={`--delay:${i * 90}ms`}>
          <p class="font-display text-4xl font-semibold text-leaf-600">{f.value}{f.unit && <span class="ml-1.5 text-base text-ink/45">{f.unit}</span>}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">{f.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="pb-24 sm:pb-32">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="font-display text-4xl font-semibold leading-tight text-forest-900" data-split>De la loi au premier kilowattheure</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink/65" data-reveal>
          La loi 82-21 permet aux particuliers, entreprises et exploitations agricoles de produire leur électricité à partir d'énergies renouvelables pour leur propre consommation, raccordés au réseau national.
        </p>
        <div class="mt-8 rounded-3xl bg-forest-900 p-7 text-white" data-reveal>
          <p class="flex items-center gap-2 font-display font-semibold text-leaf-300"><Icon name="bolt" class="h-5 w-5" />Notre conseil</p>
          <p class="mt-3 leading-relaxed text-white/80">
            Le prix de rachat de l'excédent étant nettement inférieur au prix d'achat de votre électricité, la rentabilité vient de l'<strong class="text-white">autoconsommation</strong>. Nous dimensionnons votre installation pour consommer le maximum de votre production, sans surinvestir.
          </p>
        </div>
      </div>
      <ol class="relative space-y-8 border-l-2 border-leaf-500/20 pl-8 lg:col-span-6 lg:col-start-7">
        {timeline.map((t, i) => (
          <li class="relative" data-reveal style={`--delay:${i * 100}ms`}>
            <span class="absolute -left-[42px] top-1 grid h-5 w-5 place-items-center rounded-full bg-leaf-500 ring-4 ring-leaf-100"></span>
            <p class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-leaf-600">{t.date}</p>
            <h3 class="mt-1.5 font-display text-xl font-semibold text-forest-900">{t.title}</h3>
            <p class="mt-2 leading-relaxed text-ink/65">{t.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-sand-100/70 py-20">
    <div class="container-x">
      <div class="max-w-3xl" data-reveal>
        <h2 class="font-display text-3xl font-semibold text-forest-900">Ce que nous prenons en charge</h2>
        <ul class="mt-6 space-y-3 text-ink/75">
          {['Étude de faisabilité et dimensionnement optimal', 'Constitution du dossier de raccordement auprès du gestionnaire de réseau', 'Choix du régime applicable selon la puissance et le niveau de tension', 'Installation, mise en service et suivi de la production'].map((x) => (
            <li class="flex gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-leaf-500" />{x}</li>
          ))}
        </ul>
        <a href="/contact/" class="btn btn-primary mt-8">Être accompagné<Icon name="arrow" class="h-4 w-4" /></a>
        <p class="mt-6 text-xs leading-relaxed text-ink/50">Informations fournies à titre indicatif, à jour en novembre 2026. Les textes réglementaires et arrêtés de l'ANRE font foi.</p>
      </div>
    </div>
  </section>
</Base>
