---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Simulator from '../components/Simulator.astro';
---
<Base title="Simulateur solaire" description="Estimez gratuitement la puissance solaire (kWc) nécessaire à partir de votre facture d'électricité mensuelle, ainsi que votre production et vos économies au Maroc.">
  <PageHero eyebrow="Simulateur gratuit" title="Votre facture, convertie en kilowatts-crête." lead="En quelques secondes, estimez la puissance photovoltaïque adaptée à votre consommation, la production attendue dans votre région et les économies réalisables." />

  <section class="relative -mt-20 pb-24 sm:-mt-28 sm:pb-32">
    <div class="container-x relative z-10" data-reveal="zoom">
      <Simulator />
    </div>
  </section>
</Base>
