---
import Base from '../layouts/Base.astro';
import EnergyFlow from '../components/EnergyFlow.astro';
import Waves from '../components/Waves.astro';
import Icon from '../components/Icon.astro';
import Simulator from '../components/Simulator.astro';
import Faq from '../components/Faq.astro';
import { solutions, sectors, steps, regions } from '../data/site';

const stats = [
  {
    value: 52,
    suffix: ' %',
    label:
      "Objectif d'énergies renouvelables dans le mix électrique marocain d'ici 2030",
  },
  {
    value: 28.6,
    decimals: 1,
    suffix: ' GW',
    label:
      'Potentiel du solaire décentralisé (toitures, entreprises, fermes) au Maroc',
  },
  {
    value: 1800,
    suffix: '',
    label:
      'kWh produits en moyenne par kWc installé et par an, parmi les meilleurs gisements au monde',
  },
  {
    value: 20,
    suffix: ' %',
    label:
      'Part maximale de la production annuelle revendable au réseau avec la loi 82-21',
  },
];

const strengths = [
  {
    icon: 'user',
    title: 'Un ingénieur à vos côtés',
    text: "Notre fondateur cumule une solide expérience d'ingénieur et de manager dans le solaire : centrales, pompage, éclairage. Vous parlez directement à un expert.",
  },
  {
    icon: 'globe',
    title: 'Fournisseur global',
    text: 'Étude, matériel, installation, démarches, maintenance : un seul interlocuteur, une seule responsabilité.',
  },
  {
    icon: 'shield',
    title: 'Matériel de confiance',
    text: 'Panneaux, onduleurs et pompes de marques reconnues, garanties constructeur et traçabilité complète.',
  },
  {
    icon: 'study',
    title: 'Rentabilité chiffrée',
    text: 'Chaque devis est accompagné d’une étude de production et de retour sur investissement, sans promesse irréaliste.',
  },
];
---

<Base overlayHeader>
  <!-- ============ HERO ============ -->
  <section class='grain relative isolate overflow-hidden bg-forest-950 pb-32 pt-32 text-white sm:pb-44 sm:pt-40'>
    <div class='grid-lines absolute inset-0 -z-10'></div>
    <div
      class='absolute -left-40 top-20 -z-10 h-[32rem] w-[32rem] rounded-full bg-leaf-500/25 blur-[140px]'
      data-parallax='0.15'
    ></div>
    <div
      class='absolute -right-20 -top-20 -z-10 h-[28rem] w-[28rem] rounded-full bg-sun-400/15 blur-[140px]'
      data-parallax='0.08'
    ></div>

    <div class='container-x grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]'>
      <div>
        <span
          class='eyebrow border-white/15 bg-white/5 text-leaf-300'
          data-reveal
        >
          <span class='h-1.5 w-1.5 rounded-full bg-leaf-400'></span>
          Fournisseur global de solutions photovoltaïques
        </span>
        <h1
          class='mt-6 font-display text-[2.75rem] font-semibold leading-[1.02] sm:text-6xl lg:text-7xl'
          data-split
          data-split-delay='150'
        >
          L'énergie du soleil,{' '}
          <span class='text-gradient'>maîtrisée de A à Z.</span>
        </h1>
        <p
          class='mt-6 max-w-xl text-lg leading-relaxed text-white/70'
          data-reveal
          style='--delay:450ms'
        >
          Centrales solaires, pompage solaire, éclairage autonome : FG2SP
          Energie conçoit, installe et entretient vos installations
          photovoltaïques partout au Maroc.
        </p>
        <div
          class='mt-9 flex flex-wrap gap-3'
          data-reveal
          style='--delay:600ms'
        >
          <a href='#simulateur' class='btn btn-primary' data-magnetic>
            <Icon name='calc' class='h-5 w-5' />
            Simuler mon installation
          </a>
          <a href='/solutions/' class='btn btn-ghost-dark' data-magnetic>
            Découvrir nos solutions
            <Icon name='arrow' class='h-4 w-4' />
          </a>
        </div>
        <ul
          class='mt-12 flex flex-wrap gap-x-7 gap-y-3 text-sm text-white/60'
          data-reveal
          style='--delay:750ms'
        >
          <li class='flex items-center gap-2'>
            <Icon name='check' class='h-4 w-4 text-leaf-400' />
            Étude et devis gratuits
          </li>
          <li class='flex items-center gap-2'>
            <Icon name='check' class='h-4 w-4 text-leaf-400' />
            Conforme à la loi 82-21
          </li>
          <li class='flex items-center gap-2'>
            <Icon name='check' class='h-4 w-4 text-leaf-400' />
            12 régions couvertes
          </li>
        </ul>
      </div>
      <div data-reveal='zoom' style='--delay:300ms'>
        <EnergyFlow />
      </div>
    </div>
    <Waves />
  </section>

  <!-- ============ À PROPOS ============ -->
  <section class='relative py-24 sm:py-32'>
    <div class='container-x grid gap-14 lg:grid-cols-12'>
      <div class='lg:col-span-5'>
        <span
          class='eyebrow border-leaf-500/25 bg-leaf-50 text-leaf-700'
          data-reveal
        >
          Qui sommes-nous ?
        </span>
        <h2
          class='mt-5 font-display text-4xl font-semibold leading-tight text-forest-900 sm:text-5xl'
          data-split
        >
          Un seul interlocuteur, de l'idée jusqu'au premier kilowattheure.
        </h2>
      </div>
      <div
        class='space-y-6 text-lg leading-relaxed text-ink/70 lg:col-span-6 lg:col-start-7'
        data-reveal
      >
        <p>
          <strong class='font-semibold text-forest-900'>FG2SP Energie</strong>,
          pour <em>Fournisseur Global de Solutions Solaires Photovoltaïques</em>
          , est née d'une conviction : au Maroc, le soleil est la ressource la
          plus abondante et la moins chère pour produire son électricité.
        </p>
        <p>
          Fondée par un ingénieur d'État marocain en énergétique et énergies
          renouvelables, spécialisé en énergie solaire. Son portefeuille de
          projets photovoltaïques totalise plus de 10 MWc. Il a piloté des
          projets de centrales photovoltaïques, de pompage solaire et
          d'éclairage, tout en assurant le développement commercial
          d'entreprises du secteur. FG2SP s'appuie sur cette expérience
          approfondie du secteur solaire pour vous proposer des solutions
          techniquement fiables et adaptées à vos besoins.
        </p>
        <div class='grid grid-cols-3 gap-4 pt-4'>
          {[
            ['plant', 'Centrales'],
            ['pump', 'Pompage'],
            ['light', 'Éclairage'],
          ].map(([icon, label]) => (
            <div class='rounded-2xl border border-forest-900/10 bg-white p-4 text-center'>
              <Icon name={icon} class='mx-auto h-7 w-7 text-leaf-500' />
              <p class='mt-2 font-display text-sm font-semibold text-forest-900'>
                {label}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SOLUTIONS ============ -->
  <section class='relative bg-sand-100/70 py-24 sm:py-32'>
    <div class='container-x'>
      <div class='flex flex-col justify-between gap-6 md:flex-row md:items-end'>
        <div>
          <span
            class='eyebrow border-leaf-500/25 bg-white text-leaf-700'
            data-reveal
          >
            Nos solutions
          </span>
          <h2
            class='mt-5 max-w-2xl font-display text-4xl font-semibold leading-tight text-forest-900 sm:text-5xl'
            data-split
          >
            Une réponse solaire pour chaque besoin.
          </h2>
        </div>
        <a
          href='/solutions/'
          class='btn btn-ghost self-start md:self-auto'
          data-reveal
        >
          Toutes les solutions
          <Icon name='arrow' class='h-4 w-4' />
        </a>
      </div>

      <div class='mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3'>
        {solutions.map((s, i) => (
          <a
            href={`/solutions/#${s.slug}`}
            class='card spotlight group flex flex-col p-7 transition duration-500 hover:-translate-y-1.5 hover:border-leaf-500/40 hover:shadow-[0_30px_60px_-30px_rgba(0,59,31,0.35)]'
            data-reveal
            style={`--delay:${(i % 3) * 90}ms`}
          >
            <div class='flex items-start justify-between'>
              <span class='grid h-14 w-14 place-items-center rounded-2xl bg-leaf-50 text-leaf-600 transition duration-500 group-hover:scale-110 group-hover:bg-leaf-500 group-hover:text-white'>
                <Icon name={s.icon} class='h-7 w-7' />
              </span>
              <span class='font-display text-sm font-semibold text-ink/25'>
                0{i + 1}
              </span>
            </div>
            <h3 class='mt-6 font-display text-2xl font-semibold text-forest-900'>
              {s.title}
            </h3>
            <p class='mt-3 flex-1 leading-relaxed text-ink/65'>{s.short}</p>
            <span class='mt-6 inline-flex items-center gap-2 font-display text-sm font-semibold text-leaf-600'>
              En savoir plus
              <Icon
                name='arrow'
                class='h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5'
              />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CHIFFRES ============ -->
  <section class='relative overflow-hidden bg-forest-900 py-24 text-white sm:py-28'>
    <div class='grid-lines absolute inset-0'></div>
    <div class='container-x relative'>
      <div class='max-w-2xl'>
        <span
          class='eyebrow border-white/15 bg-white/5 text-leaf-300'
          data-reveal
        >
          Le Maroc, terre de soleil
        </span>
        <h2
          class='mt-5 font-display text-4xl font-semibold leading-tight sm:text-5xl'
          data-split
        >
          Le bon moment pour{' '}
          <span class='text-gradient'>produire votre propre énergie.</span>
        </h2>
      </div>
      <div class='mt-14 grid gap-px overflow-hidden rounded-3xl bg-white/10 sm:grid-cols-2 lg:grid-cols-4'>
        {stats.map((s, i) => (
          <div
            class='bg-forest-900 p-7'
            data-reveal
            style={`--delay:${i * 100}ms`}
          >
            <p class='font-display text-5xl font-semibold tracking-tight text-leaf-300'>
              <span data-count={s.value} data-decimals={s.decimals ?? 0}>
                0
              </span>
              {s.suffix}
            </p>
            <p class='mt-4 text-sm leading-relaxed text-white/70'>{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SIMULATEUR ============ -->
  <section id='simulateur' class='relative scroll-mt-24 py-24 sm:py-32'>
    <div class='pointer-events-none absolute inset-x-0 top-0 h-80 bg-gradient-to-b from-leaf-50 to-transparent'></div>
    <div class='container-x relative'>
      <div class='mx-auto max-w-3xl text-center'>
        <span
          class='eyebrow border-leaf-500/25 bg-white text-leaf-700'
          data-reveal
        >
          <Icon name='calc' class='h-3.5 w-3.5' />
          Simulateur solaire
        </span>
        <h2
          class='mt-5 font-display text-4xl font-semibold leading-tight text-forest-900 sm:text-5xl'
          data-split
        >
          Quelle puissance pour votre facture ?
        </h2>
        <p class='mt-5 text-lg text-ink/65' data-reveal>
          Indiquez le montant de votre facture mensuelle : nous estimons la
          puissance crête (kWc) nécessaire, la production et vos économies.
        </p>
      </div>
      <div class='mt-14' data-reveal='zoom'>
        <Simulator />
      </div>
    </div>
  </section>

  <!-- ============ PROCESSUS ============ -->
  <section class='relative bg-sand-100/70 py-24 sm:py-32'>
    <div class='container-x grid gap-14 lg:grid-cols-12'>
      <div class='lg:sticky lg:top-32 lg:col-span-5 lg:self-start'>
        <span
          class='eyebrow border-leaf-500/25 bg-white text-leaf-700'
          data-reveal
        >
          Notre méthode
        </span>
        <h2
          class='mt-5 font-display text-4xl font-semibold leading-tight text-forest-900 sm:text-5xl'
          data-split
        >
          Cinq étapes, zéro mauvaise surprise.
        </h2>
        <p class='mt-5 text-lg leading-relaxed text-ink/65' data-reveal>
          Un projet solaire réussi commence par une bonne étude. Nous vous
          accompagnons à chaque étape, avec des engagements clairs.
        </p>
        <a href='/contact/' class='btn btn-primary mt-8' data-reveal>
          Démarrer mon projet
          <Icon name='arrow' class='h-4 w-4' />
        </a>
      </div>
      <ol class='relative space-y-6 lg:col-span-6 lg:col-start-7' data-progress>
        <span
          class='absolute bottom-6 left-[27px] top-6 w-0.5 bg-forest-900/10'
          aria-hidden='true'
        ></span>
        <span
          class='absolute bottom-6 left-[27px] top-6 w-0.5 origin-top scale-y-0 bg-leaf-500 transition-transform duration-200'
          data-progress-bar
          aria-hidden='true'
        ></span>
        {steps.map((s, i) => (
          <li class='step relative flex gap-6' data-step>
            <span class='step-dot relative z-10 grid h-14 w-14 shrink-0 place-items-center rounded-full border-2 border-forest-900/10 bg-white font-display text-lg font-semibold text-ink/40 transition-all duration-500'>
              {i + 1}
            </span>
            <div class='card flex-1 p-6 transition-all duration-500'>
              <h3 class='font-display text-xl font-semibold text-forest-900'>
                {s.title}
              </h3>
              <p class='mt-2 leading-relaxed text-ink/65'>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ SECTEURS ============ -->
  <section class='overflow-hidden py-20'>
    <p
      class='container-x text-center font-display text-sm font-semibold uppercase tracking-[0.2em] text-ink/40'
      data-reveal
    >
      Ils peuvent compter sur le solaire
    </p>
    <div class='relative mt-8 flex [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]'>
      <div class='flex shrink-0 animate-marquee gap-4 pr-4 hover:[animation-play-state:paused]'>
        {[...sectors, ...sectors, ...sectors, ...sectors].map((s) => (
          <div class='flex shrink-0 items-center gap-4 rounded-full border border-forest-900/10 bg-white py-3 pl-3 pr-7'>
            <span class='grid h-10 w-10 place-items-center rounded-full bg-leaf-500 text-white'>
              <Icon name='sun' class='h-5 w-5' />
            </span>
            <span>
              <span class='block font-display font-semibold text-forest-900'>
                {s.label}
              </span>
              <span class='block text-xs text-ink/50'>{s.text}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ POURQUOI ============ -->
  <section class='py-24 sm:py-28'>
    <div class='container-x'>
      <div class='mx-auto max-w-3xl text-center'>
        <span
          class='eyebrow border-leaf-500/25 bg-leaf-50 text-leaf-700'
          data-reveal
        >
          Pourquoi FG2SP ?
        </span>
        <h2
          class='mt-5 font-display text-4xl font-semibold leading-tight text-forest-900 sm:text-5xl'
          data-split
        >
          L'exigence d'un ingénieur, la proximité d'un partenaire.
        </h2>
      </div>
      <div class='mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4'>
        {strengths.map((s, i) => (
          <div
            class='card spotlight p-7'
            data-reveal
            style={`--delay:${i * 90}ms`}
          >
            <span class='grid h-12 w-12 place-items-center rounded-xl bg-forest-900 text-leaf-300'>
              <Icon name={s.icon} class='h-6 w-6' />
            </span>
            <h3 class='mt-5 font-display text-xl font-semibold text-forest-900'>
              {s.title}
            </h3>
            <p class='mt-2.5 leading-relaxed text-ink/65'>{s.text}</p>
          </div>
        ))}
      </div>

      <!-- Zones -->
      <div
        class='card mt-5 grid gap-8 p-8 lg:grid-cols-[1fr_2fr] lg:items-center'
        data-reveal
      >
        <div>
          <span class='grid h-12 w-12 place-items-center rounded-xl bg-leaf-500 text-white'>
            <Icon name='pin' class='h-6 w-6' />
          </span>
          <h3 class='mt-5 font-display text-2xl font-semibold text-forest-900'>
            Partout au Maroc
          </h3>
          <p class='mt-2 text-ink/65'>
            Nous intervenons dans les 12 régions du Royaume, du nord au sud.
          </p>
        </div>
        <ul class='flex flex-wrap gap-2'>
          {regions.map((r) => (
            <li class='cursor-default rounded-full border border-forest-900/10 bg-sand-50 px-4 py-2 text-sm text-ink/75 transition duration-300 hover:-translate-y-0.5 hover:border-leaf-500 hover:bg-leaf-500 hover:text-white'>
              {r}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ LOI 82-21 ============ -->
  <section class='pb-24 sm:pb-32'>
    <div class='container-x'>
      <a
        href='/autoproduction/'
        class='group relative block overflow-hidden rounded-[2rem] bg-gradient-to-br from-leaf-500 to-forest-800 p-8 text-white sm:p-14'
        data-reveal='zoom'
      >
        <div class='absolute -right-10 -top-10 h-64 w-64 rounded-full border-[40px] border-white/10 transition-transform duration-700 group-hover:scale-125'></div>
        <div class='absolute bottom-0 right-24 h-40 w-40 rounded-full bg-sun-400/30 blur-3xl'></div>
        <div class='relative max-w-2xl'>
          <span class='eyebrow border-white/25 bg-white/10 text-white'>
            Nouveau cadre réglementaire
          </span>
          <h2 class='mt-5 font-display text-3xl font-semibold leading-tight sm:text-5xl'>
            Loi 82-21 : produire et revendre son électricité, c'est désormais
            possible.
          </h2>
          <p class='mt-5 text-lg text-white/80'>
            Décret d'application publié en mars 2026, tarifs de rachat fixés par
            l'ANRE : ce que cela change concrètement pour vous.
          </p>
          <span class='mt-8 inline-flex items-center gap-2 font-display font-semibold'>
            Lire notre guide{' '}
            <Icon
              name='arrow'
              class='h-5 w-5 transition-transform group-hover:translate-x-2'
            />
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class='bg-sand-100/70 py-24 sm:py-32'>
    <div class='container-x grid gap-12 lg:grid-cols-12'>
      <div class='lg:col-span-4'>
        <span
          class='eyebrow border-leaf-500/25 bg-white text-leaf-700'
          data-reveal
        >
          FAQ
        </span>
        <h2
          class='mt-5 font-display text-4xl font-semibold leading-tight text-forest-900'
          data-split
        >
          Vos questions, nos réponses.
        </h2>
        <p class='mt-4 text-ink/65' data-reveal>
          Une autre question ?{' '}
          <a
            href='/contact/'
            class='font-semibold text-leaf-600 underline-offset-4 hover:underline'
          >
            Écrivez-nous
          </a>
          .
        </p>
      </div>
      <div class='lg:col-span-8'>
        <Faq />
      </div>
    </div>
  </section>
</Base>

<style>
  .step.is-active .step-dot {
    border-color: var(--color-leaf-500);
    background: var(--color-leaf-500);
    color: white;
    box-shadow: 0 0 0 8px rgb(18 160 44 / 0.12);
  }
  .step.is-active .card {
    border-color: rgb(18 160 44 / 0.3);
    box-shadow: 0 24px 50px -30px rgb(0 59 31 / 0.4);
  }
</style>
